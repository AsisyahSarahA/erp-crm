{
  "name": "astacode/astacode-kernel",
  "description": "Shared Kernel for ASTACODE ERP Monorepo Microservices",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-bcmath": "*",
    "ext-json": "*",
    "ext-openssl": "*"
  },
  "autoload": {
    "psr-4": {
      "Astacode\\Kernel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Astacode\\Kernel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Astacode\\Kernel\\AstacodeKernelServiceProvider"
      ]
    }
  }
}

