# ============================================================
# ASTACODE ERP — SHARED ENVIRONMENT TEMPLATE (.env.shared)
# Copy this template to create individual .env files per service
# ============================================================

# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Monorepo Microservice Ports & Base URLs
GATEWAY_URL=http://127.0.0.1:8000
CORE_SERVICE_URL=http://127.0.0.1:8001
CRM_SERVICE_URL=http://127.0.0.1:8002
MARKETING_SERVICE_URL=http://127.0.0.1:8003
HRD_SERVICE_URL=http://127.0.0.1:8004
PM_SERVICE_URL=http://127.0.0.1:8005
FINANCE_SERVICE_URL=http://127.0.0.1:8006
AI_SERVICE_URL=http://127.0.0.1:8007
ORCHESTRATOR_SERVICE_URL=http://127.0.0.1:8008

# Shared Secret for Internal HMAC Service Communication
INTERNAL_SERVICE_SECRET=astacode-default-internal-secret-2026

# MySQL 8 Database Configuration (Server SSH / Local)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root

# Driver Abstractions (No Redis, No Horizon, No Docker)
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# SSH Remote Tunnel (Optional if connecting from remote workstation)
SSH_TUNNEL_HOST=user@your-server-ip
SSH_TUNNEL_PORT=22
SSH_TUNNEL_LOCAL_PORT=3307
SSH_TUNNEL_REMOTE_PORT=3306

# File Storage & Virus Scanner
FILESYSTEM_DISK=private
VIRUS_SCANNER_DRIVER=null

# AI Gateway Defaults
DEFAULT_AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=60

